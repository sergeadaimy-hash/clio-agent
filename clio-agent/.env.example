# ── EVENT CONFIG ──────────────────────────────
EVENT_NAME=Event Name
EVENT_EDITION=Day 1
TIMEZONE=Asia/Riyadh
REPORT_DATE_OVERRIDE=
PORT=3000
BASE_URL=http://localhost:3000

# ── EMAIL (SMTP) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SENDER_NAME=CLIO Report Agent

# ── PM TEAM ────────────────────────────────────
PM_EMAILS=pm1@company.com,pm2@company.com
PM_WHATSAPP=+9665xxxxxxxx,+9665xxxxxxxx

# ── DEPARTMENT EMAILS ─────────────────────────
DEPT_EMAIL_STAGE=stage@company.com
DEPT_EMAIL_LIGHTING=lighting@company.com
DEPT_EMAIL_AV=av@company.com
DEPT_EMAIL_SCENIC=scenic@company.com
DEPT_EMAIL_RIGGING=rigging@company.com
DEPT_EMAIL_SHOW_DIRECTION=showdirection@company.com
DEPT_EMAIL_LOGISTICS=logistics@company.com

# ── DEPARTMENT WHATSAPP ───────────────────────
DEPT_WHATSAPP_STAGE=+9665xxxxxxxx
DEPT_WHATSAPP_LIGHTING=+9665xxxxxxxx
DEPT_WHATSAPP_AV=+9665xxxxxxxx
DEPT_WHATSAPP_SCENIC=+9665xxxxxxxx
DEPT_WHATSAPP_RIGGING=+9665xxxxxxxx
DEPT_WHATSAPP_SHOW_DIRECTION=+9665xxxxxxxx
DEPT_WHATSAPP_LOGISTICS=+9665xxxxxxxx

# ── WHATSAPP (Meta Cloud API) ─────────────────
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=choose-any-string
WHATSAPP_APP_SECRET=

# ── SECURITY ──────────────────────────────────
REPORT_API_KEY=your_secret_key_here
ADMIN_PASSWORD=your_admin_password_here

# ── STORAGE ────────────────────────────────────
# Set on Railway to the mounted volume path, e.g. /data. Leave unset locally.
DATA_DIR=
