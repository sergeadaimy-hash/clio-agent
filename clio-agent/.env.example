# ── EVENT CONFIG ──────────────────────────────
EVENT_NAME=Event Name
EVENT_EDITION=Day 1
TIMEZONE=Asia/Riyadh
REPORT_DATE_OVERRIDE=
PORT=3000
BASE_URL=http://localhost:3000

# ── EMAIL (SMTP) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SENDER_NAME=CLIO Report Agent

# ── PM TEAM ────────────────────────────────────
PM_EMAILS=pm1@company.com,pm2@company.com
PM_WHATSAPP=+9665xxxxxxxx,+9665xxxxxxxx

# ── DEPARTMENT CONTACTS (optional seed) ───────
# HOD contacts are managed from the admin Departments section; these env vars
# only seed or override contacts for the default placeholder departments.
# Slug = uppercase name, non-alphanumerics as underscores.
# Available slugs: OVERLAY_VENUE_INFRASTRUCTURE, EVENT_EXPERIENCE,
# VENUE_OPERATIONS_MANAGEMENT, SECURITY, CLEAN_WASTE_MANAGEMENT,
# TRAFFIC_MANAGEMENT, ACCREDITATION, STAFFING, GUEST_MANAGEMENT,
# FOOD_BEVERAGE, TECHNICAL_PRODUCTION, HOSPITALITY
# DEPT_EMAIL_SECURITY=security@company.com
# DEPT_WHATSAPP_SECURITY=+9665xxxxxxxx

# ── WHATSAPP (Meta Cloud API) ─────────────────
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=choose-any-string
WHATSAPP_APP_SECRET=

# ── SECURITY ──────────────────────────────────
REPORT_API_KEY=your_secret_key_here
ADMIN_PASSWORD=your_admin_password_here

# ── STORAGE ────────────────────────────────────
# Set on Railway to the mounted volume path, e.g. /data. Leave unset locally.
DATA_DIR=
